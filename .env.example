# Canonical absolute base URL for this deployment. Used when we embed a
# self-link in an outbound email (e.g., the PDF download link in the course
# delivery email). If unset, we fall back to VERCEL_PROJECT_PRODUCTION_URL,
# then VERCEL_URL, then http://localhost:3000. Set this to your real
# production domain (e.g. https://jazamedia.com) so prod emails always
# point at the canonical URL even when served from a Vercel preview.
SITE_URL=https://jazamedia.com


# Upstash Redis credentials for the distributed rate limiter on /api/career-*
# and /api/course-request. Without these, rate limiting falls back to a
# per-instance in-memory bucket — fine for local dev, leaky on Vercel.
# Create a free DB at https://console.upstash.com → "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated origin allowlist for the public POST endpoints. If unset,
# the built-in list (jaza-media.com + admin.jaza-media.com + localhost +
# *.vercel.app preview deployments) applies. Override only if rehosted.
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────
# Project URL + anon key: Supabase dashboard → Settings → API. Used by the
# browser client, middleware session refresh, and admin RLS reads. The app
# will 500 on every matched route without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SECRET — server only, never expose with NEXT_PUBLIC_).
# Used by the form APIs to insert submissions and mint signed upload URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Admin identity for the /admin dashboard gate (proxy + upload route). Falls
# back to jaza.intern@gmail.com if unset. NOTE: the Supabase RLS policies also
# hardcode the admin email, so changing admins requires updating this AND a
# migration to the policies — the database can't read this variable.
# ADMIN_EMAIL=admin@jazamedia.com

# ── Email via Resend (REQUIRED for form confirmation emails) ─────────────
# Without these, submissions still save but no emails are sent (recorded as
# missing_config on course requests). Sender must be a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional per-flow sender overrides; fall back to RESEND_FROM_EMAIL.
# CAREERS_FROM_EMAIL=
# COURSES_FROM_EMAIL=

# ── Lead-magnet asset links ──────────────────────────────────────────────
# Delivery URLs for the course/template funnels. The two course PDFs default
# to the self-hosted files in /public/ebooks, so overrides are optional. The
# two template URLs have NO default — until they are set, template claimants
# get no delivery email (recorded as missing_config in course_requests).
TEMPLATE_SALES_CALL_SCRIPT_URL=
TEMPLATE_AI_PROMPT_URL=
# COURSE_RULE_OF_10X_MARKETING_URL=
# COURSE_RULE_OF_10X_ADVERTISING_URL=

# Built-in booking (see README)
BOOKING_CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
