# Canonical absolute base URL for this deployment. Used when we embed a
# self-link in an outbound email (e.g., the PDF download link in the course
# delivery email). If unset, we fall back to VERCEL_PROJECT_PRODUCTION_URL,
# then VERCEL_URL, then http://localhost:3000. Set this to your real
# production domain (e.g. https://jazamedia.com) so prod emails always
# point at the canonical URL even when served from a Vercel preview.
SITE_URL=https://jazamedia.com

# Calendly inline-widget URL for the Partner With Us Step 2 booking page.
# Get this from your Calendly event's "Copy link" button.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jazamediaph/discovery-call?utm_id=97757_v0_s00_e0_tv0

# Upstash Redis credentials for the distributed rate limiter on /api/career-*
# and /api/course-request. Without these, rate limiting falls back to a
# per-instance in-memory bucket — fine for local dev, leaky on Vercel.
# Create a free DB at https://console.upstash.com → "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated origin allowlist for the public POST endpoints. If unset,
# the built-in list (jaza-media.com + admin.jaza-media.com + localhost +
# *.vercel.app preview deployments) applies. Override only if rehosted.
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
